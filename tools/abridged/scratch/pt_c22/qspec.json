{
 "168.b25.q": [
  "168:4.5",
  "A nenhuma prece",
  "negada uma resposta"
 ],
 "169.b12.q": [
  "169:1.10",
  "esse filho meu",
  "foi encontrado"
 ],
 "169.b30.q": [
  "169:4.12",
  "O Deus dos universos",
  "nas vossas mentes."
 ],
 "169.b36.q": [
  "169:1.2",
  "ao mesmo tempo que estais",
  "encontrar-vos."
 ],
 "170.b32.q": [
  "170:5.21",
  "Assim a chamada igreja",
  "agora adormecido."
 ],
 "170.b38.q": [
  "170:5.19",
  "o Reino é a vontade",
  "daquele que crê"
 ],
 "171.b5.q": [
  "171:0.6",
  "o Filho do Homem não veio",
  "mas para ministrar"
 ],
 "172.b5.q": [
  "172:1.3",
  "gostaria que as paredes",
  "todos os homens"
 ],
 "172.b24.q": [
  "172:4.2",
  "Esta pobre viúva",
  "todos os outros"
 ],
 "173.b12.q": [
  "173:1.7",
  "A minha casa",
  "covil de ladrões"
 ],
 "173.b35.q": [
  "173:5.3",
  "Não terei aqui",
  "oferecidas a todos"
 ],
 "174.b12.q": [
  "174:1.4",
  "E quando amais",
  "já o perdoastes."
 ],
 "174.b21.q": [
  "174:3.2",
  "o meu Pai não é",
  "mas dos vivos."
 ],
 "174.b35.q": [
  "174:1.3",
  "O perdão divino",
  "compreensão infinita de Deus"
 ],
 "175.b11.q": [
  "175:1.10",
  "aquele que quer ser o maior",
  "servidor de todos."
 ],
 "176.b5.q": [
  "176:3.10",
  "Gratuitamente vós recebestes",
  "a deveis dar"
 ],
 "176.b17.q": [
  "176:2.4",
  "O olho da carne",
  "glorificado pelo Pai"
 ]
}